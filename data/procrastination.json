  "branches": [
    { "label": "Self-awareness", "detail": "Figure out your \"why\" — why you're putting things off.", "align": "left", "x": 422, "y": 370.992, "w": 196 },
    { "label": "Just do it", "detail": "\"Oh, that was actually easy — why didn't I do it ages ago?\"", "align": "right", "x": 786.78, "y": 488.377, "w": 201.6 },
    { "label": "Started ≠ finished", "detail": "Slow, imperfect progress is totally fine.", "align": "right", "x": 710.343, "y": 81.2213, "w": 244 },
    { "label": "Live in the present", "detail": "Thinking about how long it'll take is what keeps you stuck.", "align": "left", "x": 276, "y": 442.327, "w": 256 },
    { "label": "Just do ONE", "detail": "If it's under 2 minutes, do it right away.", "align": "right", "x": 603.201, "y": 238.364, "w": 160.8 },
    { "label": "Lower your bar", "detail": "Free yourself from the all-or-nothing mentality.", "align": "right", "x": 602, "y": 418.079, "w": 196 },
    { "label": "B-work is fine", "detail": "B-level work done is far from failure.", "align": "right", "x": 808, "y": 416.841, "w": 196, "focused": true },
    { "label": "Use a timer", "detail": "Pomodoro: 25 work, 5 break, longer break after 4.", "align": "left", "x": 197.6, "y": 370.945, "w": 177.6 },
    { "label": "Break it down", "detail": "Smaller pieces are more manageable.", "align": "right", "x": 602, "y": 149.169, "w": 184 },
    { "label": "Track to build trust", "detail": "You'll learn how much time things actually take.", "align": "left", "x": 422, "y": 227.888, "w": 268 },
    { "label": "Three-strike rule", "detail": "Put off 3 times? Next time you remember — do it.", "align": "right", "x": 772, "y": 211.063, "w": 232 },
    { "label": "Make it inconvenient", "detail": "Make procrastinating harder than starting.", "align": "left", "x": 422, "y": 513.354, "w": 268 },
    { "label": "Drop the emotions", "detail": "Don't attach negative feelings to tasks.", "align": "right", "x": 641.413, "y": 347.659, "w": 232 },
    { "label": "Downplay difficulty", "detail": "Don't let your mind lie to you.", "align": "left", "x": 422, "y": 155.985, "w": 256 },
    { "label": "Not every piece is a gem", "detail": "No Pulitzer needed for every essay.", "align": "left", "x": 336, "y": 84.3701, "w": 316 },
    { "label": "Rest is allowed", "detail": "Take a nap. You might just be tired.", "align": "right", "x": 796, "y": 280.917, "w": 208 },
    { "label": "Start messy", "detail": "You can clean it up later. Starting is the whole battle.", "align": "left", "x": 214.4, "y": 227.401, "w": 194.4 },
    { "label": "Reward yourself", "detail": "Crossing things off instills motivation.", "align": "left", "x": 235.654, "y": 299.308, "w": 208 }
  ],
